# Copy to .env on the VPS before `docker compose up`.
# Never commit real secrets.

# Required in production (use a long random string)
SESSION_SECRET=change-me-to-a-long-random-value

# Optional — enables GPT responses in Comandos when set
OPENAI_API_KEY=

# App (defaults are fine for Docker)
PORT=4000
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
